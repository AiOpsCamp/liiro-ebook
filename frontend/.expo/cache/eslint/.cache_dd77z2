 71 |\n> 72 |   const drawerHeight = heightAnim.interpolate({\n     |                        ^^^^^^^^^^ Passing a ref to a function may read its value during render\n  73 |     inputRange: [0, 1],\n  74 |     outputRange: [headerHeight + insets.bottom, contentHeight + insets.bottom]});\n  75 |","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/humayunrashid/multicamp/liiro-ebook/frontend/components/auth/BottomDrawer.tsx:72:24\n  70 |   }, [isDrawerOpen, tagsHeight, headerHeight, buttonsHeight, insets.bottom]);\n  71 |\n> 72 |   const drawerHeight = heightAnim.interpolate({\n     |                        ^^^^^^^^^^^^^^^^^^^^^^ Passing a ref to a function may read its value during render\n  73 |     inputRange: [0, 1],\n  74 |     outputRange: [headerHeight + insets.bottom, contentHeight + insets.bottom]});\n  75 |","import/no-duplicates","'/Users/humayunrashid/multicamp/liiro-ebook/frontend/lib/utils.ts' imported multiple times.","Literal",{"range":"1444","text":"1445"},"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/humayunrashid/multicamp/liiro-ebook/frontend/components/auth/LanguageSelector.tsx:39:21\n  37 |   onSelect}) => {\n  38 |    \n> 39 |   const scaleAnim = useRef(new Animated.Value(1)).current;\n     |                     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  40 |\n  41 |   const handlePress = () => {\n  42 |     onSelect(item);","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/humayunrashid/multicamp/liiro-ebook/frontend/components/auth/LearningGoalSelector.tsx:120:46\n  118 |\n  119 |    \n> 120 |   return <View className=\"flex-1\">{goals.map((item, idx) => renderItem({ item, idx }))}</View>;\n      |                                              ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  121 | };\n  122 |\n  123 | export default LearningGoalSelector;","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/humayunrashid/multicamp/liiro-ebook/frontend/components/auth/RegistrationForm.tsx:212:20\n  210 |   const [showConfirmPassword, setShowConfirmPassword] = useState(false);\n  211 |   const isTablet = width > 768;\n> 212 |   const fadeAnim = useRef(new Animated.Value(0)).current;\n      |                    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  213 |   const slideAnim = useRef(new Animated.Value(50)).current;\n  214 |\n  215 |   useEffect(() => {","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/humayunrashid/multicamp/liiro-ebook/frontend/components/auth/RegistrationForm.tsx:213:21\n  211 |   const isTablet = width > 768;\n  212 |   const fadeAnim = useRef(new Animated.Value(0)).current;\n> 213 |   const slideAnim = useRef(new Animated.Value(50)).current;\n      |                     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  214 |\n  215 |   useEffect(() => {\n  216 |     setInputValues(formData);","react-hooks/set-state-in-effect","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/Users/humayunrashid/multicamp/liiro-ebook/frontend/components/auth/RegistrationForm.tsx:216:5\n  214 |\n  215 |   useEffect(() => {\n> 216 |     setInputValues(formData);\n      |     ^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  217 |   }, [formData]);\n  218 |\n  219 |   useEffect(() => {","React Hook useEffect has missing dependencies: 'fadeAnim' and 'slideAnim'. Either include them or remove the dependency array.",["1446"],"'commonDomains' is assigned a value but never used.","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/humayunrashid/multicamp/liiro-ebook/frontend/components/auth/RegistrationForm.tsx:453:16\n  451 |     <View className=\"flex-1\">\n  452 |       <Animated.View\n> 453 |         style={{\n      |                ^\n> 454 |           opacity: fadeAnim,\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 455 |           transform: [{ translateY: slideAnim }]}}\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  456 |         className=\"p-3\"\n  457 |       >\n  458 |         {/* Name fields */}","'auth' is defined but never used.",["1447"],"'AppColors' is defined but never used.",["1448"],"'SoundscapeTrack' is defined but never used.",["1449"],["1450"],["1451"],"'TrendingUp' is defined but never used.",["1452"],"Using exported name 'ContinueCard' as identifier for default import.",["1453"],"'EbookCategory' is defined but never used.",["1454"],"'EbookTag' is defined but never used.",["1455"],"'BookSeries' is defined but never used.",["1456"],"'setSelectedAuthor' is assigned a value but never used.","'handleBack' is assigned a value but never used.","'isSelected' is assigned a value but never used.","'Sparkles' is defined but never used.",["1457"],"react-hooks/purity","Error: Cannot call impure function during render\n\n`Date.now` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\n/Users/humayunrashid/multicamp/liiro-ebook/frontend/components/ebook/EbookNotificationsModal.tsx:34:27\n  32 |       title: \"🎧 New Audiobook Release: Frankenstein\",\n  33 |       body: \"Adam's multi-voice narration for Frankenstein is now available in your library.\",\n> 34 |       createdAt: new Date(Date.now() - 86400000).toISOString(),\n     |                           ^^^^^^^^^^ Cannot call impure function\n  35 |     },\n  36 |   ]);\n  37 |   const [loading, setLoading] = useState(false);","Error: Cannot access variable before it is declared\n\n`fetchNotifications` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\n/Users/humayunrashid/multicamp/liiro-ebook/frontend/components/ebook/EbookNotificationsModal.tsx:41:5\n  39 |   useEffect(() => {\n  40 |     if (!visible) return;\n> 41 |     fetchNotifications();\n     |     ^^^^^^^^^^^^^^^^^^ `fetchNotifications` accessed before it is declared\n  42 |   }, [visible]);\n  43 |\n  44 |   const fetchNotifications = async () => {\n\n/Users/humayunrashid/multicamp/liiro-ebook/frontend/components/ebook/EbookNotificationsModal.tsx:44:3\n  42 |   }, [visible]);\n  43 |\n> 44 |   const fetchNotifications = async () => {\n     |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 45 |     try {\n     | ^^^^^^^^^\n> 46 |       setLoading(true);\n     …\n     | ^^^^^^^^^\n> 55 |     }\n     | ^^^^^^^^^\n> 56 |   };\n     | ^^^^^ `fetchNotifications` is declared here\n  57 |\n  58 |   const handleMarkAllRead = async () => {\n  59 |     try {","'ExternalLink' is defined but never used.",["1458"],"'Filter' is defined but never used.",["1459"],"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/Users/humayunrashid/multicamp/liiro-ebook/frontend/components/ebook/EbookReviewsSection.tsx:66:5\n  64 |\n  65 |   useEffect(() => {\n> 66 |     fetchReviews();\n     |     ^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  67 |   }, [storySlug, activeFilter]);\n  68 |\n  69 |   const handleLike = async (reviewId: string) => {","React Hook useEffect has a missing dependency: 'fetchReviews'. Either include it or remove the dependency array.",["1460"],"Using exported name 'AudioManager' as identifier for default import.","@typescript-eslint/array-type","Array type using 'Array<T>' is forbidden. Use 'T[]' instead.","TSTypeReference","errorStringArray",{"range":"1461","text":"1462"},["1463"],"'Zap' is defined but never used.",["1464"],"'Settings' is defined but never used.",["1465"],["1466"],"'Award' is defined but never used.",["1467"],["1468"],"'CheckCircle2' is defined but never used.",["1469"],"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/humayunrashid/multicamp/liiro-ebook/frontend/components/ebook/read/AudioPlayerBar.tsx:99:27\n   97 |   const audioManagerRef = useRef(AudioManager.getInstance());\n   98 |   const initialTimestampConsumedRef = useRef(false);\n>  99 |   const playButtonScale = useRef(new RNAnimated.Value(1)).current;\n      |                           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  100 |\n  101 |   // Subscribe to live position updates from AudioManager\n  102 |   useEffect(() => {","The ref value 'audioManagerRef.current' will likely have changed by the time this effect cleanup function runs. If this ref points to a node rendered by React, copy 'audioManagerRef.current' to a variable inside the effect, and use that variable in the cleanup function.","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/Users/humayunrashid/multicamp/liiro-ebook/frontend/components/ebook/read/AudioPlayerBar.tsx:119:5\n  117 |   // Reset state when chapter audio changes\n  118 |   useEffect(() => {\n> 119 |     setIsPlaying(false);\n      |     ^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  120 |     setCurrentTime(0);\n  121 |     setDuration(0);\n  122 |     initialTimestampConsumedRef.current = false;","'Markdown' is defined but never used.",["1470"],"'EbookReaderHeader' is defined but never used.",["1471"],"'EbookReaderFooterPlayer' is defined but never used.",["1472"],"'EbookReaderSettingsModal' is defined but never used.",["1473"],"'EbookReaderTocModal' is defined but never used.",["1474"],"'/Users/humayunrashid/multicamp/liiro-ebook/frontend/api/storiesQuery.ts' imported multiple times.",{"range":"1475","text":"1476"},["1477"],"'Type' is defined but never used.",["1478"],"'HighlightItem' is defined but never used.",["1479"],"'STORAGE_KEY_PREFIX' is assigned a value but never used.",["1480","1481","1482","1483"],["1484","1485","1486","1487"],"react/display-name","Component definition is missing display name","noDisplayName","'height' is assigned a value but never used.","'setBookmarkedChapters' is assigned a value but never used.","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/Users/humayunrashid/multicamp/liiro-ebook/frontend/components/ebook/read/EbookReadContent.tsx:553:9\n  551 |       const currentDev = Platform.OS === \"web\" ? \"web-desktop\" : Platform.OS;\n  552 |       if (whispersyncRes.whispersync.deviceType !== currentDev) {\n> 553 |         setShowWhispersyncModal(true);\n      |         ^^^^^^^^^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  554 |         setHasPromptedWhispersync(true);\n  555 |       }\n  556 |     }","react-hooks/preserve-manual-memoization","Compilation Skipped: Existing memoization could not be preserved\n\nReact Compiler has skipped optimizing this component because the existing manual memoization could not be preserved. The inferred dependencies did not match the manually specified dependencies, which could cause the value to change more or less frequently than expected. The inferred dependency was `chapterStub`, but the source dependencies were [chapterStub?._id, story.slug, toggleBookmark]. Inferred less specific property than source.\n\n/Users/humayunrashid/multicamp/liiro-ebook/frontend/components/ebook/read/EbookReadContent.tsx:768:44\n  766 |   );\n  767 |\n> 768 |   const handleToggleBookmark = useCallback(async () => {\n      |                                            ^^^^^^^^^^^^^\n> 769 |     if (!chapterStub?._id) return;\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 770 |     try {\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 771 |       Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Medium);\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 772 |       await toggleBookmark({ slug: story.slug, chapterId: chapterStub._id }).unwrap();\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 773 |     } catch (err) {\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 774 |       console.error(\"Failed to toggle bookmark:\", err);\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 775 |     }\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 776 |   }, [chapterStub?._id, story.slug, toggleBookmark]);\n      | ^^^^ Could not preserve existing manual memoization\n  777 |\n  778 |   const handleSaveHighlight = useCallback(async () => {\n  779 |     if (!chapterStub?._id || !highlightModalData) return;","Compilation Skipped: Existing memoization could not be preserved\n\nReact Compiler has skipped optimizing this component because the existing manual memoization could not be preserved. The inferred dependencies did not match the manually specified dependencies, which could cause the value to change more or less frequently than expected. The inferred dependency was `chapterStub`, but the source dependencies were [addHighlight, chapterStub?._id, highlightColor, highlightModalData, highlightNote, story.slug]. Inferred less specific property than source.\n\n/Users/humayunrashid/multicamp/liiro-ebook/frontend/components/ebook/read/EbookReadContent.tsx:778:43\n  776 |   }, [chapterStub?._id, story.slug, toggleBookmark]);\n  777 |\n> 778 |   const handleSaveHighlight = useCallback(async () => {\n      |                                           ^^^^^^^^^^^^^\n> 779 |     if (!chapterStub?._id || !highlightModalData) return;\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 780 |     try {\n      …\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 793 |     }\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 794 |   }, [addHighlight, chapterStub?._id, highlightColor, highlightModalData, highlightNote, story.slug]);\n      | ^^^^ Could not preserve existing manual memoization\n  795 |\n  796 |   const handleDeleteHighlight = useCallback(async (highlightId?: string) => {\n  797 |     if (!highlightId) return;","React Hook useEffect has a missing dependency: 'story.contentType'. Either include it or remove the dependency array.",["1488"],"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/Users/humayunrashid/multicamp/liiro-ebook/frontend/components/ebook/read/EbookReadContent.tsx:1043:7\n  1041 |   useEffect(() => {\n  1042 |     if (!hasAutoStarted && (startAsAudio || readingMode === \"audiobook\") && story?.slug && !isPlaying) {\n> 1043 |       setHasAutoStarted(true);\n       |       ^^^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  1044 |       const timer = setTimeout(() => {\n  1045 |         togglePlayPause();\n  1046 |       }, 600);","React Hook useEffect has missing dependencies: 'eq1', 'eq2', 'eq3', 'eq4', 'eq5', and 'pulseAnim'. Either include them or remove the dependency array.",["1489"],"'_' is defined but never used.","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/Users/humayunrashid/multicamp/liiro-ebook/frontend/components/ebook/read/EbookReadContent.tsx:1199:7\n  1197 |       audioElementRef.current?.pause();\n  1198 |       if (audioElementRef.current) audioElementRef.current.volume = audioVolume;\n> 1199 |       setIsPlaying(false);\n       |       ^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  1200 |       setSleepTimerEnd(null);\n  1201 |       return;\n  1202 |     }","Compilation Skipped: Existing memoization could not be preserved\n\nReact Compiler has skipped optimizing this component because the existing manual memoization could not be preserved. The inferred dependencies did not match the manually specified dependencies, which could cause the value to change more or less frequently than expected. The inferred dependency was `story.title`, but the source dependencies were [chapterDetails?.textPayload, chapterDetails?.content, chapterStub?.title, chapterStub?.chapterNumber, currentChapterIdx, story?.title, activeLang]. Inferred different dependency than source.\n\n/Users/humayunrashid/multicamp/liiro-ebook/frontend/components/ebook/read/EbookReadContent.tsx:1225:30\n  1223 |\n  1224 |   // Clean Payload Text & Strip Redundant Leading Headers\n> 1225 |   const paragraphs = useMemo(() => {\n       |                              ^^^^^^^\n> 1226 |     const rawPayload = chapterDetails?.textPayload || chapterDetails?.content;\n       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 1227 |     const rawText = getLocalizedText(rawPayload, \"\", activeLang);\n       …\n       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 1264 |     return cleanedParas.length > 0 ? cleanedParas : rawParas;\n       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 1265 |   }, [chapterDetails?.textPayload, chapterDetails?.content, chapterStub?.title, chapterStub?.chapterNumber, currentChapterIdx, story?.title, activeLang]);\n       | ^^^^ Could not preserve existing manual memoization\n  1266 |\n  1267 |   const processedPayload = useMemo(() => {\n  1268 |     return paragraphs.join(\"\\n\\n\");","'chNum' is assigned a value but never used.","'processedPayload' is assigned a value but never used.","React Hook useEffect has a missing dependency: 'readProgress'. Either include it or remove the dependency array.",["1490"],"React Hook useEffect has a missing dependency: 'syncProgress'. Either include it or remove the dependency array.",["1491"],["1492"],["1493"],"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/humayunrashid/multicamp/liiro-ebook/frontend/components/ebook/read/EbookReadContent.tsx:1428:3\n  1426 |\n  1427 |   // Keep stable refs so keyboard handler doesn't need re-registration\n> 1428 |   handleNextChapterRef.current = handleNextChapter;\n       |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^ Cannot update ref during render\n  1429 |   handlePrevChapterRef.current = handlePrevChapter;\n  1430 |   isSearchOpenRef.current = isSearchOpen;\n  1431 |   togglePlayPauseRef.current = togglePlayPause;","Error: